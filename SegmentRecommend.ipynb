    "\n",
    "# List of tables you want to fetch\n",
    "table_names = [\"test_segment\", \"appointments_df\", \"age_segment\",\"dept_segment\",\"leaves_df\",\"doctors_df\"]\n",
    "\n",
    "# Dictionary to store DataFrames\n",
    "dfs = {}\n",
    "\n",
    "for table in table_names:\n",
    "    response = requests.post(BASE_URL, params={\"table_name\": table})\n",
    "    \n",
    "    if response.status_code == 200:\n",
    "        data = response.json()\n",
    "        df = pd.DataFrame(data)\n",
    "        dfs[table] = df   # Store DataFrame in dictionary with table name as key\n",
    "        print(f\"✅ Loaded table: {table} with {len(df)} rows\")\n",
    "    else:\n",
    "        print(f\"❌ Failed to load {table}: {response.status_code}\")\n",
    "\n",
    "# Access DataFrames individually\n",
    "test_segment = dfs[\"test_segment\"]\n",
    "age_segment = dfs[\"age_segment\"]\n",
    "dept_segment = dfs[\"dept_segment\"]\n",
    "leaves_df = dfs[\"leaves_df\"]\n",
    "appointments_df = dfs[\"appointments_df\"]\n",
    "doctors_df = dfs[\"doctors_df\"]\n"
